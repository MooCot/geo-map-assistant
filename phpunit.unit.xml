<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <!--
        Pure unit tests: no WordPress bootstrap, no database. Fast, run on
        every commit. See tests/Unit/README.md (or CLAUDE.md) for why only
        AIProviderManager lives here — it's the one class with no $wpdb/WP
        function dependency, thanks to its constructor accepting an
        explicit $providers array.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
